# ===========================================
# TAPS Backend Environment Variables
# ===========================================
# Copy to .env for local usage when needed.
# Prefer shell env vars for secrets in shared environments.

# Spring: include oracle to enable the Oracle read API.
# SPRING_PROFILES_ACTIVE=oracle

# Oracle (TCPS)
DATABASE_HOST=
DATABASE_PORT=1543
DATABASE_SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
KEYSTORE_SECRET=
TRUSTSTORE_PATH=/cert/jssecacerts
# Local only: a plain TCP Oracle instead of the TCPS descriptor above.
# SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

# Optional Oracle timeouts
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_READ_TIMEOUT_MS=30000
# DATABASE_QUERY_TIMEOUT_SECONDS=20

# BC Gov SSO / FAM
TAPS_OIDC_ISSUER_URI=
TAPS_OIDC_CLIENT_ID=

# App config
TAPS_IMAGE_REFERENCE=local
TAPS_HTTP_WORKER_THREADS=64
APP_LOG_LEVEL=INFO
TAPS_FAILURE_DIAGNOSTICS_LOG_LEVEL=INFO
