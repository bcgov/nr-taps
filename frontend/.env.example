# BC Gov SSO / FAM browser authentication. No browser client secret.
# Register http://localhost:3000/authCallback and logout http://localhost:3000
VITE_OIDC_ISSUER_URI=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_IDIR_HINT=azureidir
VITE_OIDC_BCEID_HINT=bceidbusiness
# SiteMinder logoff chained before Keycloak logout, so signing out ends the Business BCeID session.
# DEV and TEST realms use the test SiteMinder; PROD uses https://logon7.gov.bc.ca/clp-cgi/logoff.cgi
VITE_OIDC_SITEMINDER_LOGOUT_URL=https://logontest7.gov.bc.ca/clp-cgi/logoff.cgi

# Local dev server and /api proxy (used by Vite only).
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_TARGET=http://localhost:8080
