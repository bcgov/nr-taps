# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	# Keep the admin/metrics endpoint available to the container without exposing it on the pod network.
	admin 127.0.0.1:3003
	# Apply browser security headers even when the WAF rejects a request.
	order coraza_waf after header
	log default {
		# Coraza messages at any severity can embed request values and cannot be field-filtered.
		# Use only its AKZ audit log for rule details; access logs retain paths/status/timing.
		exclude http.handlers.waf
		format filter {
			wrap console
			fields {
				# Headers can contain custom credentials, referrers and OAuth redirect URLs.
				request>uri regexp \?.*$ ""
				request>headers delete
				resp_headers delete
			}
		}
	}
}
(security_headers) {
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca;
			script-src 'self';
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com 'unsafe-inline';
			font-src 'self' https://fonts.gstatic.com https://www2.gov.bc.ca;
			img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org;
			frame-ancestors 'self';
			form-action 'self';
			block-all-mixed-content;
			connect-src 'self' https://loginproxy.gov.bc.ca https://*.loginproxy.gov.bc.ca;"
		Referrer-Policy "no-referrer"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}
}
:3000 {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				resp_headers delete
			}
		}
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip
	file_server
	@spa_router {
		not path /api* /assets/*
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa_router {http.matchers.file.relative}
	# Proxy requests to API service
	reverse_proxy /api* {$BACKEND_URL} {
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Real-IP {remote_host}
		# Avoid keeping requests pinned to a backend pod after its Service endpoint is removed.
		transport http {
			keepalive off
		}
	}
	# Vite fingerprints production asset filenames, so assets can use a one-year immutable cache policy.
	# Keep the SPA shell, runtime config, API responses, and unversioned public files uncached.
	@immutable_assets {
		path /assets/*
		file
	}
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"
	@missing_assets {
		path /assets/*
		not file
	}
	header @missing_assets Cache-Control "no-store"
	@dynamic_responses {
		not path /assets/*
	}
	header @dynamic_responses Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
	import security_headers
	# Caddy handles proxy failures and missing files through a separate error route.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "" {err.status_code}
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
